includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    level: 8

    # Larastan 3.10 does not infer enum casts declared via Laravel 13's method-based
    # casts() (only the legacy protected $casts array property), so it treats User::$role
    # and Invoice::$status as their raw DB string type and flags correct enum usage as
    # errors. Scoped by message to only these two enum classes, so a genuine bug carrying
    # the same error identifier elsewhere in the app is never masked.
    ignoreErrors:
        - '#App\\Enums\\UserRole#'
        - '#App\\Enums\\InvoiceStatus#'
        - '#Cannot access property \$value on string#'
        # The same method-based casts() gap applies to Invoice::$issue_date and
        # $due_date ('date' cast): Larastan treats them as strings, so calls
        # like toDateString() and startOfDay() are flagged as calls on a
        # non-object. Scoped to those two method names only.
        - '#Cannot call method (toDateString|startOfDay)\(\) on string#'
        # Knock-on effect of the two ignores above: a Collection::map() closure
        # that accesses an unresolved enum or date-cast property anywhere in its
        # body loses its own inferable return type, surfacing as these two
        # separate identifiers on top of the already-ignored root cause. Scoped
        # to app/Mcp/Tools, the only place both gaps are combined in one closure.
        -
            identifier: argument.unresolvableType
            path: app/Mcp/Tools/*
        -
            identifier: method.unresolvableReturnType
            path: app/Mcp/Tools/*
        # Same InvoiceStatus method-cast gap again: Larastan treats
        # Invoice::$status as a plain string, so a `$status === EnumCase`
        # comparison is (wrongly) considered always false, which cascades
        # into "unreachable"/"always false" on the code that follows.
        -
            identifier: deadCode.unreachable
            path: app/Mcp/Tools/*
        -
            identifier: ternary.alwaysFalse
            path: app/Mcp/Tools/*
        # Same root cause once more: when the misread status comparison sits in
        # a private helper only ever called from inside a Closure passed to
        # Idempotency::remember(), Larastan concludes the call is unreachable
        # and reports the helper itself as unused, or that it never reaches its
        # success-path return statement.
        -
            identifier: method.unused
            path: app/Mcp/Tools/*
        -
            identifier: return.unusedType
            path: app/Mcp/Tools/*
        -
            identifier: booleanAnd.alwaysFalse
            path: app/Policies/*
        # Larastan contradicts itself on Invoice::$updated_at?->timestamp: flags the
        # nullsafe as unnecessary (never null) here, but flags the non-nullsafe form
        # as a possible null-property access elsewhere. Keeping the defensively
        # correct nullsafe form and suppressing this specific false positive.
        -
            identifier: nullsafe.neverNull
            path: app/Actions/GenerateInvoicePdf.php
